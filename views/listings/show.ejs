<% layout("/listings/layouts/boilerplate") %>
<br/>
<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3> Listing Details </h3>
    </div>
    <div class="card col-6 offset-3 show-card">        
            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <br>
                    <b><%= listing.title %></b> <br />
                    <%= listing.description %> <br />
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> <br />
                    <%= listing.location %> <br />
                    <%= listing.country %> <br />
                </p>
            </div>
    </div>

    <br>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark offset-4 edit-btn"> Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
        
        
    </div>
</div>
